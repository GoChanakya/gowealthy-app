# nse-service
# Local port (Cloud Run injects PORT=8080 automatically)
PORT=3000

# NSE MFSS credentials (spec v1.9.6, "Common Authentication For All APIs")
NSE_LOGIN_ID=
NSE_API_SECRET=
NSE_MEMBER_API_KEY=
NSE_MEMBER_CODE=

# UAT : https://nseinvestuat.nseindia.com
# PROD: https://www.nseinvest.com
NSE_BASE_URL=https://nseinvestuat.nseindia.com

# Optional overrides
# NSE_REFERER=
# NSE_ORIGIN=
# NSE_USER_AGENT=
# NSE_TIMEOUT_MS=60000
