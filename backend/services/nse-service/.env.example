# nse-service
# Local port (Cloud Run injects PORT=8080 automatically)
PORT=3000

# NSE MFSS credentials (spec v1.9.6, "Common Authentication For All APIs")
NSE_LOGIN_ID=
NSE_API_SECRET=
NSE_MEMBER_API_KEY=
NSE_MEMBER_CODE=

# UAT : https://nseinvestuat.nseindia.com
# PROD: https://www.nseinvest.com
NSE_BASE_URL=https://nseinvestuat.nseindia.com

# Optional overrides
# NSE_REFERER=
# NSE_ORIGIN=
# NSE_USER_AGENT=
# NSE_TIMEOUT_MS=60000

# RazorpayX composite Fund Account Validation (real penny drop; live mode only)
# API credentials from Razorpay Dashboard -> Account & Settings -> API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RazorpayX Dashboard -> My Account & Settings -> Banking -> Customer Identifier
RAZORPAYX_ACCOUNT_NUMBER=

# Optional Razorpay overrides
# RAZORPAY_BASE_URL=https://api.razorpay.com
# RAZORPAY_TIMEOUT_MS=15000
# RAZORPAY_POLL_ATTEMPTS=8
# RAZORPAY_POLL_INTERVAL_MS=1000
